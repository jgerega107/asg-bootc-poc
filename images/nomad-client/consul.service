# Based on HashiCorp's packaged Consul unit:
# https://github.com/hashicorp/consul/blob/main/.release/linux/package/usr/lib/systemd/system/consul.service
[Unit]
Description="HashiCorp Consul client agent"
Documentation=https://developer.hashicorp.com/consul/docs
Requires=network-online.target cloud-config.service
After=network-online.target cloud-config.service
ConditionFileNotEmpty=/etc/consul.d/consul.hcl
ConditionFileNotEmpty=/etc/consul.d/90-runtime.hcl

[Service]
Type=notify
EnvironmentFile=-/etc/consul.d/consul.env
User=consul
Group=consul
ExecStart=/usr/bin/consul agent -config-dir=/etc/consul.d/
ExecReload=/bin/kill --signal HUP $MAINPID
KillMode=process
KillSignal=SIGTERM
Restart=on-failure
LimitNOFILE=65536
StateDirectory=consul
StateDirectoryMode=0750
UMask=0027

[Install]
WantedBy=multi-user.target
